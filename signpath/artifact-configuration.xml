<?xml version="1.0" encoding="utf-8"?>
<!--
  signpath/artifact-configuration.xml
  ===========================================================================
  Configuracao de artefacto da SignPath para o YT-DLP Media Desk.
  Criar na SignPath com o slug:  mediadesk-release   (ver SIGNPATH.md, secao 8).

  Estrutura do artefacto (fluxo GitHub Actions):
    O workflow carrega a PASTA build/signpath/stage (os 3 executaveis crus).
    O actions/upload-artifact empacota-a num ZIP de transporte, logo o elemento
    raiz e <zip-file> e os .exe ficam a UM nivel:

      signpath-unsigned.zip            (ZIP de transporte criado pelo GitHub)
      |  MediaDesk-Portable.exe
      |  MediaDesk-Setup.exe
      +  MediaDesk-Portable/YT-DLP-Media-Desk.exe

    NAO carregar o nosso proprio ZIP (build/signpath/signpath-*.zip): isso
    criaria um ZIP dentro do ZIP de transporte e os <pe-file> internos nunca
    seriam encontrados (bug classico do actions/upload-artifact com arquivos
    pre-empacotados). Para submissao MANUAL na web, o ZIP que o
    tools/prep_signpath.ps1 gera tambem encaixa nesta mesma configuracao
    (raiz <zip-file>, com os 3 .exe dentro).

  Restricoes de metadados (obrigatorias nos termos OSS da SignPath):
    product-name e product-version tem de bater EXATAMENTE com o binario.
    Os 3 ficheiros: ProductName = "YT-DLP Media Desk" e
    ProductVersion = <versao do build> (parametro 'version', lido de
    version.json pelo workflow). CompanyName = "ALDACO" em todos.

    NOTA: nao se restringe file-version porque o Inno Setup escreve "3.6.0"
    enquanto os executaveis .NET escrevem "3.6.0.0". E nao se restringe
    original-filename porque o valor herdado do .NET e "YT-DLP-Media-Desk.dll".

  IMPORTANTE (padding do Inno Setup):
    O instalador sai do Inno com os campos preenchidos com espacos (largura
    fixa do stub). A SignPath compara de forma exata, por isso o padding e
    removido antes da submissao por tools/normalize_versioninfo.ps1 (chamado
    dentro de tools/prep_signpath.ps1). Sem esse passo, o pedido de assinatura
    falharia na restricao product-name/product-version do MediaDesk-Setup.exe.

  Parametro obrigatorio do pedido de assinatura:  version  (ex.: "3.7.0")
  ===========================================================================
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">

  <zip-file>

    <!-- Launcher da pasta portatil (aplicacao .NET / WPF). -->
    <pe-file path="MediaDesk-Portable/YT-DLP-Media-Desk.exe"
             product-name="YT-DLP Media Desk"
             product-version="${version}"
             company-name="ALDACO">
      <authenticode-sign />
    </pe-file>

    <!-- Auto-extraivel (SFX com o payload completo). -->
    <pe-file path="MediaDesk-Portable.exe"
             product-name="YT-DLP Media Desk"
             product-version="${version}"
             company-name="ALDACO">
      <authenticode-sign />
    </pe-file>

    <!-- Instalador (Inno Setup; metadados normalizados antes da submissao). -->
    <pe-file path="MediaDesk-Setup.exe"
             product-name="YT-DLP Media Desk"
             product-version="${version}"
             company-name="ALDACO">
      <authenticode-sign />
    </pe-file>

  </zip-file>

</artifact-configuration>
