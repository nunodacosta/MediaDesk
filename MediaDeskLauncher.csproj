<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Nome do executavel publicado. Igual ao nome do produto e ao nome usado
         pelos atalhos/instalador. O espaco e suportado pelo .NET; mantem-se
         coerente com "Media Desk Setup.exe" e "Media Desk Portable". -->
    <AssemblyName>Media Desk</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>YT-DLP Media Desk</Product>
    <AssemblyTitle>YT-DLP Media Desk</AssemblyTitle>
    <Company>ALDACO</Company>
    <Copyright>Design e interacao por ALDACO. Motor de downloads por YT-DLP. Software livre: GPL-3.0.</Copyright>
    <Version>3.12.0</Version>
    <FileVersion>3.12.0.0</FileVersion>
    <InformationalVersion>3.12.0</InformationalVersion>
    <!-- .NET SDK 8+ anexa "+<commit>" ao InformationalVersion/ProductVersion por
         omissao; desligar para o ProductVersion ser exatamente "3.6.0" e bater
         certo com o instalador (restricao de metadados da SignPath). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" /></ItemGroup>
  <!-- O splash nativo desenha o mesmo icone do executavel: fica embebido para
       nao depender de app.ico ao lado do .exe (o portatil pode ser solto). -->
  <ItemGroup><EmbeddedResource Include="app.ico" LogicalName="app.ico" /></ItemGroup>
</Project>
