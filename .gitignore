# ============================================================================
#  YT-DLP Media Desk — .gitignore
#  Mantém fora do repositório PÚBLICO os dados de utilizador/dev e as pastas
#  de build. Requisito para o repo público (SignPath OSS) e para privacidade.
# ============================================================================

# --- Dados de utilizador/dev (NUNCA publicar) --------------------------------
config.json
config.json.bak
*.bak
cookies.txt
history.json
sessions.json
download_queue.json
download_queue.json.tmp
downloads/

# --- Serviço de atividade (dados cifrados e estado local) --------------------
data/
activity.enc
activity.key
rss_channels.json
rss_proposals.json
activity.log
activity_service.heartbeat
activity_service.lock
data/.meta_*.jsonl

# --- Saídas de build / runtime local ----------------------------------------
dist/
build/
bin/
ffmpeg/
obj/
__pycache__/
*.py[cod]
*.pyo

# --- Pastas locais/de trabalho ----------------------------------------------
bkp/
dev/
Actualizações/
*.WebView2/

# --- Saídas de ferramentas de desenvolvimento --------------------------------
.playwright-mcp/
server_crash.log
nul
rss_proposals.json.*.tmp

# --- Artefactos de publicação .NET (gerados, não versionar) ------------------
publish_out/
MediaDesk-Portable/
/cache/
/runtimes/
/cs/
/de/
/es/
/fr/
/it/
/ja/
/ko/
/pl/
/pt-BR/
/ru/
/tr/
/zh-Hans/
/zh-Hant/
Microsoft.*.xml
Microsoft.Services.Store.winmd
createdump.exe
*.dll
*.pdb
*.exe

# --- Restos locais -----------------------------------------------------------
YT-DLP-Media-Desk.exe
*.pfx
*.p12
*.snk

# --- Notas locais (rascunho, nao publicar) -----------------------------------
fimes.txt
ADICIONAR.txt
correções e implementações.txt
